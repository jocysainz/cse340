<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <p><a href="/new-project">Add a New Service Project</a></p>

        <% if (projects.length> 0) { %>
            <ul>
                <% projects.forEach(project=> { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <strong>
                                <%= project.title %>
                            </strong>
                        </a>
                        - <%= project.location %><br>
                            <em>
                                <%= project.date %>
                            </em>
                    </li>
                    <% }); %>
            </ul>
            <% } else { %>
                <p>No projects found.</p>
                <% } %>
    </main>
    <%- include('partials/footer') %>