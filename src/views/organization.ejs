<%- include('partials/header') %>
    <main>
        <h2>
            <%= organizationDetails.name %>
        </h2>

        <img class="main-logo" src="/images/<%= organizationDetails.logo_filename %>"
            alt="<%= organizationDetails.name %> logo">

        <p>
            <%= organizationDetails.description %>
        </p>

        <p><strong>Contact:</strong>
            <%= organizationDetails.contact_email %>
        </p>

        <p><a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a></p>

        <h2>Associated Service Projects</h2>
        <% if (projects.length> 0) { %>
            <ul>
                <% projects.forEach(project=> { %>
                    <li>
                        <strong>
                            <%= project.title %>
                        </strong> - <%= project.location %><br>
                            <em>
                                <%= project.date %>
                            </em><br>
                            <%= project.description %>
                    </li>
                    <% }); %>
            </ul>
            <% } else { %>
                <p>No service projects found for this organization.</p>
                <% } %>
    </main>
    <%- include('partials/footer') %>