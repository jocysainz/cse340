<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <ul class="categories-list">
            <% categories.forEach(category=> { %>
                <li>
                    <h2>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                    </h2>
                </li>
                <% }) %>
        </ul>
    </main>

    <%- include('partials/footer') %>