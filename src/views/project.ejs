<%- include('partials/header') %>
    <main>
        <h2>
            <%= project.title %>
        </h2>

        <p>
            <%= project.description %>
        </p>
        <p><strong>Location:</strong>
            <%= project.location %>
        </p>
        <p><strong>Date:</strong>
            <%= project.date %>
        </p>

        <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>

        <h3>Categories</h3>
        <% if (categories && categories.length> 0) { %>
            <ul class="category-tags">
                <% categories.forEach(cat=> { %>
                    <li>
                        <%= cat.name %>
                    </li>
                    <% }); %>
            </ul>
            <% } else { %>
                <p>No categories assigned to this project.</p>
                <% } %>
    </main>
    <%- include('partials/footer') %>